# Copy this file to .env and fill in the values for your environment.
# Never commit your real .env — it's already in .gitignore.

# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# Find these in your Supabase project: Settings -> API.
# The "publishable" key is safe to expose in the browser (hence VITE_ prefix).
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
SUPABASE_PROJECT_ID="YOUR_PROJECT_REF"
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_REF"

# Server-only, service-role key. Bypasses Row Level Security — never expose
# this to the browser and never prefix it with VITE_. Only needed if you use
# src/integrations/supabase/client.server.ts for admin operations.
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx"

# ---------------------------------------------------------------------------
# AI Health Coach (required for the /member chat feature)
# ---------------------------------------------------------------------------
# Set exactly ONE of the keys below — src/lib/ai-provider.ts auto-detects
# which provider to use based on which key is present. To force a specific
# provider when more than one key is set, also set AI_PROVIDER.
#
#   AI_PROVIDER=lovable | openai | gemini | anthropic   (optional override)

# Option 1: Lovable AI Gateway — only issued inside Lovable Cloud.
# LOVABLE_API_KEY="..."
# LOVABLE_MODEL="google/gemini-3.6-flash"   # optional, this is the default

# Option 2: OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"                 # optional, this is the default

# Option 3: Google Gemini — https://aistudio.google.com/app/apikey
# GEMINI_API_KEY="..."
# GEMINI_MODEL="gemini-2.0-flash"            # optional, this is the default

# Option 4: Anthropic Claude — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-3-5-haiku-latest"  # optional, this is the default

# ---------------------------------------------------------------------------
# Sign-in
# ---------------------------------------------------------------------------
# This app uses email/password sign-up only — no Google sign-in, no extra
# environment variables needed here. See DEPLOY.md for a note on Supabase's
# email-confirmation redirect if this is a Lovable Cloud-managed project.

# ---------------------------------------------------------------------------
# Deployment target (optional — see DEPLOY.md)
# ---------------------------------------------------------------------------
# NITRO_PRESET="node-server"   # e.g. netlify | node-server | cloudflare-module
# VERCEL is set automatically by Vercel's build environment — no action needed.
